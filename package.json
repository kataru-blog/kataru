{
    "name": "kataru",
    "scripts": {
        "dev:local": "bun run --hot main.ts",
        "dev:island": "bun run --watch scripts/development.ts",
        "dev:css": "tailwindcss -i ./assets/styles-raw.css -o ./assets/styles.css --watch --minify",
        "dev": "wrangler dev --live-reload & bun run dev:island & bun run dev:css",
        "dev:wrangler": "wrangler dev --live-reload",
        "build": "bun run scripts/build.ts && bun run build:css",
        "build:css": "tailwindcss -i ./assets/styles-raw.css -o ./assets/styles.css --minify",
        "deploy": "bun run build && wrangler deploy && bunx wrangler d1 migrations apply kataru --remote",
        "db:reset": "bun run scripts/reset.ts",
        "db:init": "bun run scripts/init.ts",
        "db:update": "bun run scripts/update.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "wrangler d1 migrations apply kataru --local",
        "kill:all": "bun run scripts/kill-wrangler.ts"
    },
    "dependencies": {
        "@cloudflare/kv-asset-handler": "^0.4.0",
        "@hono/react-renderer": "^1.0.1",
        "@radix-ui/react-avatar": "^1.1.10",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "better-auth": "^1.3.7",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.13",
        "drizzle-orm": "^0.44.2",
        "embla-carousel-autoplay": "^8.6.0",
        "embla-carousel-react": "^8.6.0",
        "hast-util-sanitize": "^5.0.2",
        "hast-util-to-string": "^3.0.1",
        "hono": "^4.8.4",
        "lucide-react": "^0.542.0",
        "mysql2": "^3.14.2",
        "next-themes": "^0.4.6",
        "react": "^19",
        "react-dom": "^19",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-external-links": "^3.0.0",
        "rehype-highlight": "^7.0.2",
        "rehype-sanitize": "^6.0.0",
        "rehype-slug": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "tw-animate-css": "^1.3.7",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.0.0",
        "zod": "^4.1.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20250823.0",
        "@tailwindcss/cli": "^4.1.11",
        "@types/bun": "^1.2.20",
        "@types/node": "^24.3.0",
        "better-sqlite3": "^12.2.0",
        "drizzle-kit": "^0.31.4",
        "feconfig-bhs": "^1.0.7",
        "shadcn": "^3.0.0",
        "tailwindcss": "^4.1.11",
        "wrangler": "^4.32.0"
    }
}